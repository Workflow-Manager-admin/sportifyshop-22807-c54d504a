# Example backend environment variables for sports_gear_backend

# SQLite DB file location (relative to backend root or absolute path)
SQLITE_DB_FILENAME=sports_gear.db

# FastAPI/Secret
SECRET_KEY=change-this-to-a-strong-secret-key

# Stripe credentials (replace with your test/production keys)
STRIPE_SECRET_KEY=sk_test_dummystripeapikey

# Stripe web checkout URLs
CHECKOUT_SUCCESS_URL=https://example.com/success
CHECKOUT_CANCEL_URL=https://example.com/cancel

# Enable stack traces and debug info in error responses (set to True/False or "development"/"production")
DEBUG=True
ENV=development
